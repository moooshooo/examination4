# backend/.env.example — kopiera till .env och fyll i riktiga värden

# PostgreSQL (interna Docker-nätverket)
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/toads_delight

# RabbitMQ (interna Docker-nätverket)
RABBITMQ_URL=amqp://guest:change_me@rabbitmq:5672

# Redis (interna Docker-nätverket)
REDIS_URL=redis://redis:6379
