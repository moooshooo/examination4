# .env.example — kopiera till .env och fyll i riktiga värden

# Publik ingång (nginx — enda exponerade porten i prod)
NGINX_PORT=8015

# Infrastrukturportar (bara tillgängliga lokalt under dev)
POSTGRES_PORT=5415
RABBITMQ_PORT=5615
RABBITMQ_MANAGEMENT_PORT=15615
REDIS_PORT=6315

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=toads_delight

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me

# Forgejo
FORGEJO_USER=change_me
FORGEJO_PASS=change_me
FORGEJO_HOST=change_me
FORGEJO_PORT=5555
